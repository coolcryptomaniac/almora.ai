rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function moderator() {
      return signedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['category','location','description','status','source','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.source == 'resident'
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 160
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 3000;
      allow read, update, delete: if moderator();
    }

    match /publicIssues/{id} { allow read: if true; allow write: if moderator(); }
    match /facilities/{id} { allow read: if true; allow write: if moderator(); }
    match /jobs/{id} { allow read: if true; allow write: if moderator(); }
    match /transport/{id} { allow read: if true; allow write: if moderator(); }
    match /businesses/{id} { allow read: if true; allow write: if moderator(); }
    // Ownership claims are private so public business cards never expose account UIDs.
    match /businessOwners/{businessId} {
      allow read: if moderator() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if moderator();
    }
    match /businessOwnershipSubmissions/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['ownerUid','businessId','applicantPhone','evidenceNote','status','createdAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.businessId is string
                    && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
                    && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.status == 'approved'
                    && !exists(/databases/$(database)/documents/businessOwners/$(request.resource.data.businessId))
                    && request.resource.data.applicantPhone.matches('^[0-9]{10,13}$')
                    && request.resource.data.evidenceNote is string
                    && request.resource.data.evidenceNote.size() >= 10
                    && request.resource.data.evidenceNote.size() <= 500
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp;
      allow read: if moderator() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if moderator();
    }
    match /verifiedSources/{id} { allow read: if true; allow write: if moderator(); }
    match /serviceProviders/{id} { allow read: if true; allow write: if moderator(); }

    match /serviceRequests/{id} {
      allow create: if signedIn()
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data['service'] is string
                    && request.resource.data['service'].size() <= 80
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 160
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 2000;
      allow read: if moderator() || (signedIn() && resource.data.requesterUid == request.auth.uid);
      allow update, delete: if moderator();
    }

    match /jobSubmissions/{id} {
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role is string
                    && request.resource.data.role.size() <= 120
                    && request.resource.data.employer is string
                    && request.resource.data.employer.size() <= 160
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 160;
      allow read: if moderator() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if moderator();
    }

    match /businessSubmissions/{id} {
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 160
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 120
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 160;
      allow read: if moderator() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if moderator();
    }

    // Owner-managed local commerce: customers can see approved listings only.
    match /marketplaceProducts/{id} {
      allow read: if resource.data.status == 'approved';
      allow write: if moderator();
    }

    match /marketplaceProductSubmissions/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['ownerUid','businessId','businessName','location','name','category','price','unit','description','whatsapp','publicContactConsent','status','createdAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.businessId is string
                    && request.resource.data.businessName is string
                    && request.resource.data.businessName.size() <= 160
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 160
                    && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
                    && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.status == 'approved'
                    && exists(/databases/$(database)/documents/businessOwners/$(request.resource.data.businessId))
                    && get(/databases/$(database)/documents/businessOwners/$(request.resource.data.businessId)).data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.category in ['food','craft','home','services']
                    && request.resource.data.price is number
                    && request.resource.data.price >= 1
                    && request.resource.data.price <= 1000000
                    && request.resource.data.unit is string
                    && request.resource.data.unit.size() <= 30
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 500
                    && request.resource.data.whatsapp.matches('^[0-9]{10,13}$')
                    && request.resource.data.publicContactConsent == true
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp;
      allow read: if moderator() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if moderator();
    }

    // Delivery applicants keep their phone private until opt-in and approval.
    match /deliveryPartnerSubmissions/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['ownerUid','displayName','whatsapp','vehicle','coverageArea','startingFee','publicContactConsent','status','createdAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 70
                    && request.resource.data.whatsapp.matches('^[0-9]{10,13}$')
                    && request.resource.data.vehicle in ['On foot','Bicycle','Scooter / motorcycle','Car / van','Other']
                    && request.resource.data.coverageArea is string
                    && request.resource.data.coverageArea.size() > 0
                    && request.resource.data.coverageArea.size() <= 140
                    && request.resource.data.startingFee is number
                    && request.resource.data.startingFee >= 0
                    && request.resource.data.startingFee <= 10000
                    && request.resource.data.publicContactConsent == true
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp;
      allow read: if moderator() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if moderator();
    }

    match /localDeliveryPartners/{id} {
      allow read: if resource.data.status == 'approved';
      allow write: if moderator();
    }

    match /jobApplications/{id} {
      allow create: if signedIn()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'submitted';
      allow read: if moderator() || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow update, delete: if moderator();
    }

    match /moderators/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /candidateProfiles/{uid} {
      allow read, write: if owner(uid);
    }

    // AETHERHOME public-safe funding indications. Public records contain no email or personal contact details.
    match /aetherhomeIndications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['publicLabel','amount','investorType','status','createdAt','nonbinding'])
                    && request.resource.data.publicLabel is string
                    && request.resource.data.publicLabel.size() <= 80
                    && request.resource.data.amount is int
                    && request.resource.data.amount >= 10000
                    && request.resource.data.amount <= 100000000
                    && request.resource.data.investorType is string
                    && request.resource.data.investorType.size() <= 80
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.nonbinding == true;
      allow read: if moderator() || resource.data.status == 'verified';
      allow update, delete: if moderator();
    }

    // Sensitive investor contact data is never publicly readable.
    match /aetherhomeIndicationContacts/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','organization','email','note','createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.organization is string
                    && request.resource.data.organization.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 160
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 500
                    && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if moderator();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
